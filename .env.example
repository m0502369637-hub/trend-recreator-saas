# Local secrets for dev tooling (scripts/) and `npx convex dev`.
# NEVER commit this file. In production these live as Convex env vars
# (`npx convex env set NAME value`), not in the repo.
#
# The base repo declares only these. A SaaS repo adds its provider's secrets
# to convex/convex.config.ts + this file.
#
# Required:
BOT_TOKEN=
WEBHOOK_SECRET=dev
# Price per generation, in Telegram Stars (positive integer). Lives only here
# — change it anytime without redeploying: npx convex env set SERVICE_COST '120'
SERVICE_COST=
# Comfy Cloud (this repo's provider). Use your PRODUCTION key at launch.
COMFY_API_KEY=
COMFY_API_BASE=https://cloud.comfy.org
# API-format workflow JSON with __IMAGE__ / __VIDEO__ placeholders (≤ 8 KB).
# Keep the graph out of git — put it in the Convex env, not in this file's history.
COMFY_WORKFLOW=
# Optional Instagram reel downloader template, e.g. https://api.example/?url={url}
COMFY_REEL_RESOLVER=
# Prod webhook target for `npm run webhook:set`:
WEBHOOK_URL=
# Dev long-polling target (defaults to http://127.0.0.1:3210):
DEV_HTTP_URL=
